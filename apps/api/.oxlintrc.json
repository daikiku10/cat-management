{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "overrides": [
    {
      "files": ["src/index.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    }
  ]
}
